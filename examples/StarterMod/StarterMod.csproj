<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ExampleMimicPartyMod</AssemblyName>
    <Version>1.0.0</Version>
    <CoreReference Condition="'$(CoreReference)' == ''">$(MimicPartyPath)/BepInEx/plugins/MimicPartyModdingCore.dll</CoreReference>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json;https://nuget.samboy.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" IncludeAssets="compile" PrivateAssets="all" />
    <Reference Include="MimicPartyModdingCore"><HintPath>$(CoreReference)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireInstalledCore" BeforeTargets="ResolveReferences" Condition="!Exists('$(CoreReference)')">
    <Error Text="Core DLL not found. Build with -p:MimicPartyPath=&quot;path to Mimic Party&quot; or -p:CoreReference=&quot;full DLL path&quot;." />
  </Target>
</Project>
